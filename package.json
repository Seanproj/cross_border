{
  "name": "cross-border-life-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "data:check": "tsx scripts/db.ts check",
    "db:up": "docker run -d --name cbl-db -e POSTGRES_PASSWORD=postgres -p 54329:5432 supabase/postgres:17.12.0.000 && node scripts/wait-for-db.mjs",
    "db:down": "docker rm -f cbl-db",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm data:check"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "8.23.1",
    "supabase": "3.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@10.28.0"
}
